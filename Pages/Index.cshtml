@page
@model IndexModel
@{
    ViewData["Title"] = "Добредојдовте - Препорака на Дестинации";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<style>
    body {
        background: #f4f7f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .hero-banner {
        background: linear-gradient(135deg, #0d6efd 0%, #084298 100%);
        border-radius: 0 0 2.5rem 2.5rem;
        padding: 3.5rem 1rem 4.5rem 1rem;
        color: white;
    }
    .search-card {
        margin-top: -3rem;
        border: none;
        border-radius: 1.5rem;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: white;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #0a58ca 0%, #084298 100%);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 15px rgba(13, 110, 253, 0.3);
    }
    .destination-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 1.25rem;
        overflow: hidden;
    }
    .destination-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    .top-hero-card {
        border-left: 8px solid #198754 !important;
    }
    .img-wrapper {
        position: relative;
        height: 220px;
        overflow: hidden;
    }
    .top-hero-card .img-wrapper {
        height: 320px;
    }
    .img-wrapper img {
        object-fit: cover;
        width: 100%;
        height: 100%;
    }
    .badge-price {
        position: absolute;
        top: 1rem;
        right: 1rem;
        backdrop-filter: blur(8px);
        background: rgba(0, 0, 0, 0.65);
        color: #fff;
        padding: 0.5rem 0.9rem;
        border-radius: 2rem;
        font-weight: 600;
    }
</style>

<!-- Хедер со новото Добредојде и Текст -->
<div class="hero-banner text-center">
    <div class="container">
        <span class="badge bg-white text-primary px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">
            ✨ Твојот Асистент за Патување
        </span>
        <h1 class="fw-bold display-4 mb-2">Добредојдовте !</h1>
        <p class="lead opacity-90 mb-0">Систем за препорака на туристички дестинации</p>
    </div>
</div>

<div class="container mb-5">
    <!-- Форма за Пребарување -->
    <div class="card shadow-lg search-card p-4 p-md-5 bg-white">
        <form method="get">
            <div class="row g-3 align-items-end">
                
                <!-- Буџет -->
                <div class="col-md-4">
                    <label class="form-label fw-bold text-dark"><i class="bi bi-wallet2 text-primary me-1"></i> 1. Внеси Буџет (€):</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light border-end-0 fw-bold text-muted">€</span>
                        <input type="number" name="budget" value="@Model.Budget" class="form-control bg-light border-start-0" placeholder="Пр. 1000" min="50" max="10000" required />
                    </div>
                </div>

                <!-- Клима -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark"><i class="bi bi-sun text-warning me-1"></i> 2. Клима (Опционално):</label>
                    <select name="climate" class="form-select form-select-lg bg-light">
                        <option value="All" selected="@(Model.SelectedClimate == "All")">🌍 Сите клими</option>
                        <option value="Warm" selected="@(Model.SelectedClimate == "Warm")">☀️ Топло време</option>
                        <option value="Cold" selected="@(Model.SelectedClimate == "Cold")">❄️ Ладно време</option>
                    </select>
                </div>

                <!-- Тип на Одмор -->
                <div class="col-md-3">
                    <label class="form-label fw-bold text-dark"><i class="bi bi-compass text-info me-1"></i> 3. Тип на Одмор (Опционално):</label>
                    <select name="type" class="form-select form-select-lg bg-light">
                        <option value="All" selected="@(Model.SelectedType == "All")">✨ Сите типови</option>
                        <option value="Beach" selected="@(Model.SelectedType == "Beach")">🏖️ Плажа и одмор</option>
                        <option value="Culture" selected="@(Model.SelectedType == "Culture")">🏛️ Култура и историја</option>
                        <option value="Nature" selected="@(Model.SelectedType == "Nature")">🌲 Природа и авантура</option>
                    </select>
                </div>

                <!-- Копче -->
                <div class="col-md-2">
                    <button type="submit" class="btn btn-gradient btn-lg w-100 fw-bold shadow">
                        <i class="bi bi-search me-1"></i> Пребарај
                    </button>
                </div>

            </div>
        </form>
    </div>

    <!-- Резултати -->
    @if (Model.IsSearched)
    {
        @if (Model.TopRecommendation != null)
        {
            <!-- ГЛАВНА ПРЕПОРАЧАНА ДЕСТИНАЦИЈА -->
            <div class="mb-5">
                <div class="d-flex align-items-center mb-3">
                    <span class="badge bg-success p-2 fs-6 me-2 shadow-sm"><i class="bi bi-star-fill me-1"></i> Главна Препорака</span>
                    <h3 class="fw-bold text-dark mb-0">Твојата Најдобра Опција</h3>
                </div>

                <div class="card border-0 shadow-lg top-hero-card destination-card bg-white">
                    <div class="row g-0">
                        <div class="col-lg-6 img-wrapper">
                            <img src="@Model.TopRecommendation.ImageUrl" alt="@Model.TopRecommendation.Destination" />
                            <span class="badge-price fs-6">
                                <i class="bi bi-tag-fill me-1"></i>€@Model.TopRecommendation.MinBudgetEUR - €@Model.TopRecommendation.MaxBudgetEUR
                            </span>
                        </div>
                        <div class="col-lg-6 card-body p-4 p-lg-5 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h2 class="fw-bold text-dark mb-0">@Model.TopRecommendation.Destination</h2>
                                    <span class="badge bg-light text-dark border fs-6">
                                        @(Model.TopRecommendation.Climate == "Warm" ? "☀️ Топло" : "❄️ Ладно")
                                    </span>
                                </div>
                                <p class="lead text-muted mb-4">@Model.TopRecommendation.Description</p>
                            </div>

                            <!-- Смештај -->
                            @if (!string.IsNullOrEmpty(Model.TopRecommendation.HotelName))
                            {
                                <div class="p-3 p-md-4 bg-light rounded-4 border">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-success">
                                            <i class="bi bi-building me-1"></i>Препорачано Сместување
                                        </span>
                                        <span class="badge bg-success fs-6">€@Model.TopRecommendation.HotelPrice / ноќ</span>
                                    </div>
                                    <h5 class="fw-bold mb-1 text-dark">@Model.TopRecommendation.HotelName</h5>
                                    <div class="text-secondary small"><strong>Тип:</strong> @Model.TopRecommendation.HotelType</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ДРУГИ ДЕСТИНАЦИИ ВО ИСТИОТ ЦЕНОВЕН РАНГ -->
            @if (Model.OtherRecommendations.Any())
            {
                <hr class="my-5" />

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h4 class="fw-bold text-dark mb-0">
                        <i class="bi bi-grid-fill text-primary me-2"></i>Сите останати дестинации во овој ценовен ранг
                    </h4>
                    <span class="badge bg-secondary rounded-pill px-3 py-2">Достапни: @Model.OtherRecommendations.Count</span>
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var item in Model.OtherRecommendations)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm destination-card bg-white">
                                <div class="img-wrapper">
                                    <img src="@item.ImageUrl" alt="@item.Destination" />
                                    <span class="badge-price">
                                        <i class="bi bi-tag-fill me-1"></i>€@item.MinBudgetEUR - €@item.MaxBudgetEUR
                                    </span>
                                </div>

                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="fw-bold text-dark mb-0">@item.Destination</h5>
                                        <span class="badge bg-light text-dark border">
                                            @(item.Climate == "Warm" ? "☀️ Топло" : "❄️ Ладно")
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-4 flex-grow-1">@item.Description</p>

                                    <!-- Смештај Инфо -->
                                    @if (!string.IsNullOrEmpty(item.HotelName))
                                    {
                                        <div class="p-3 bg-light rounded-3 border">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="fw-bold text-success small">
                                                    <i class="bi bi-building me-1"></i>Сместување
                                                </span>
                                                <span class="badge bg-success">€@item.HotelPrice / ноќ</span>
                                            </div>
                                            <div class="fw-bold small text-dark">@item.HotelName</div>
                                            <div class="text-secondary small">@item.HotelType</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <div class="alert alert-warning d-inline-block px-4 py-3 mb-0 rounded-3">
                    <h5 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle me-1"></i> Нема пронајдено дестинации</h5>
                    <p class="mb-0 text-muted">Вашиот буџет (€@Model.Budget) е премал за моментално достапните дестинации.</p>
                </div>
            </div>
        }
    }
</div>